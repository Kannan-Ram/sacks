# Local LLM Configuration (OpenAI-compatible API)
# Base URL for your local LLM server (e.g., LM Studio, Ollama with OpenAI compatibility)
LLM_BASE_URL=http://127.0.0.1:1234/v1

# API key (some local LLM servers require this, use any value if not needed)
LLM_API_KEY=placeholder-api-key

# Model names (use the exact model names from your LLM server)
LLM_MODEL_NAME=placeholder-model
LLM_EMBEDDING_MODEL=placeholder-embedding

# Neo4j Configuration
# Use bolt:// for standalone Neo4j (neo4j:// is for clusters with routing)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=placeholder-password

# Application Configuration
# Directory for temporary file storage
UPLOAD_DIR=./uploads
WORKING_DIR=./working

# SAP Analytics Cloud (SAC) specific configuration
# Set USE_SAC_MODE=true to use SAC-optimized settings for product documentation
# This enables:
# - Smaller chunk sizes (600 tokens) for precise feature extraction
# - Larger overlap (100 tokens) to capture feature relationships
# - Separate working directory and workspace namespace
USE_SAC_MODE=false
SAC_WORKING_DIR=./working_sac
SAC_WORKSPACE=sac-product-docs

# Logging
LOG_LEVEL=INFO

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
