MERGE (term_account:GlossaryTerm {name: "account", description: "A special dimension that includes accounts like operating income and expenses, and drivers like units sold. Often used in finance models, storing calculations, aggregation type, and units."})
MERGE (term_account)-[:PART_OF]->(glossary)
MERGE (term_account_model:GlossaryTerm {name: "account model", description: "A type of import data model with a mandatory account dimension and a single default measure. The account dimension stores calculations, aggregation types, and units for measure values."})
